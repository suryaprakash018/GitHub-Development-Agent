# ==============================================================================
# Autonomous AI + Data Development Agent Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your personal values.
# NEVER commit the actual .env file containing API keys or personal paths.

# Primary AI Provider Configuration
# Set your Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Target Repository Configuration
# Absolute path to the SEPARATE target repository where development work will occur.
# Must NOT point to the GitHub-Development-Agent directory itself.
# Example Windows: C:/Users/surya/documents/AI-Data-Portfolio
# Example Linux/Mac: /home/username/projects/AI-Data-Portfolio
TARGET_REPOSITORY_PATH=

# Operational Safety Flags
# DRY_RUN: When true, planning, code generation, and testing will execute,
# but NO commits or git pushes will be performed.
DRY_RUN=true

# AUTO_COMMIT: When false, requires explicit authorization before creating commits.
AUTO_COMMIT=false

# AUTO_PUSH: When false, requires explicit authorization before pushing to remote.
AUTO_PUSH=false

# AI Model Selection
GEMINI_MODEL=gemini-3.8-flash

# Optional Gemini thinking level (LOW, MEDIUM, HIGH; default: model default)
# THINKING_LEVEL=LOW

# Target Git Branch
TARGET_BRANCH=main

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
